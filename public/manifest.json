{
  "manifest_version": 3,
  "name": "Youtube Skin Manager",
  "version": "1.0",
  "description": "Customize your YouTube appearance",
  "permissions": [
    "storage"
  ],
  "action":{
    "default_popup": "index.html",
    "default_title": "Youtube Skin"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": ["RainDropStyles.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
